# Copy this file to .env for local testing with `netlify dev`.
# In production, set these as Environment Variables in the Netlify dashboard instead
# (Site configuration → Environment variables → use "Same value for all deploy contexts").
# Never commit real values.

# From Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Price of the AI Summary unlock, in whole rupees (no decimals)
UNLOCK_PRICE_INR=399

# From openrouter.ai → Keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# Your live site URL (used to build redirect/callback links)
SITE_URL=https://freescreenrecording.net

# Any long random string — used to sign the unlock token. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNLOCK_TOKEN_SECRET=replace-with-a-long-random-string

# Note: Supabase's URL and anon key are NOT set here — they go directly into
# index.html (see docs/DEPLOYMENT_GUIDE.md step 6). That's intentional: the
# anon key is designed to be public in frontend code; real protection comes
# from the Row Level Security policies in docs/supabase-schema.sql.
